{
  "name": "multi-ai-chat",
  "version": "0.2.2",
  "description": "Chrome Side Panel for reliable multi-AI workflows across ChatGPT, Claude, Gemini, and Grok",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "webpack --watch --mode development",
    "assets:promo": "node scripts/generate-promo-tile.js",
    "assets:screenshot": "node scripts/generate-store-screenshot.js",
    "assets:store": "npm run assets:promo && npm run assets:screenshot",
    "build": "webpack --mode production",
    "check:version": "node scripts/check-version.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mts\"",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:version",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.23",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.1.1",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
